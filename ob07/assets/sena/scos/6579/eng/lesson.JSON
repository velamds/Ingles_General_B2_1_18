ack"}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}], "id": 11, "stimuli_ids": []}], "type": "scholar", "stimuli": [{"template_override": 1, "type": "welcome", "_data": [], "contents": [{}], "id": 0}, {"template_override": 1, "type": "audio", "id": 2, "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn9le18ob07re2aud01", "coverimg": "engenn9le18ob07re2img01.jpg", "images": [{"image": "engenn9le18ob07re2img01.jpg", "text": "", "time": "0", "id": 0}, {"image": "engenn9le18ob07re2img01.jpg", "text": "<span class= \"strong\"> Vanessa</span>: Hey Sally. We got five people. Milton had his son come down and I got Cindy to join us as well. They are just over there. Who did you get?<br />\n<span class= \"strong\"> Sally</span>: I couldn't get anyone V. Sorry.<br />\n<span class= \"strong\"> Vanessa</span>: Uggh!  We have to get someone to play with us.<br />\n<span class= \"strong\"> Vanessa</span>:  Hi. Jose? What are you doing now?<br />\n<span class= \"strong\"> Jose</span>: Hi, Vanessa. I'm at work.<br />\n<span class= \"strong\"> Vanessa</span>: Well I need you to come down to the fairgrounds as fast as you can, you are going to throw axes with me.<br />\n<span class= \"strong\"> Jose</span>: Okay, but I am working now. I mean there is a lot to do here; the dishes need to be washed, the tables need bussing, the floor needs sweeping and my tables need to be served.<br />\n<span class= \"strong\"> Vanessa</span>: Don't worry about that. I'll get Tanya to cover for you. Now hustle down here. You know where to go? Take a cab. It's on me.<br />\n<span class= \"strong\"> Jose</span>: Okay. I'm on my way.<br />\n<span class= \"strong\"> Sally</span>: Vanessa? Have you lost your mind?<br />\n<span class= \"strong\"> Vanessa</span>: Maybe, Sally. Maybe.<br />", "time": "100", "id": 1}, {"image": "engenn9le18ob07re2img02.jpg", "text": "<span class= \"strong\"> Sally</span>: Well, finishing last happens. I mean, I had fun. It was very animated and for me it was worth it.<br />\n<span class= \"strong\"> Vanessa</span>: Thanks Sally. You're a good friend.<br />\nWell, back to work. I better get the bartender to check the keg.<br />", "time": "61000", "id": 2}, {"image": "engenn9le18ob07re2img05.jpg", "text": "<span class= \"strong\"> Joan</span>: Hey Vanessa. How was the axe throwing today?<br />\n<span class= \"strong\"> Vanessa</span>: It was \u2026 ok.<br />\n<span class= \"strong\"> Joan</span>: Yeah. I was surprised Peter didn't go with you.<br />\n<span class= \"strong\"> Vanessa</span>: You saw Peter?<br />\n<span class= \"strong\"> Joan</span>: Yeah. He was at a bistro downtown at about 1:30 having a drink and watching the game.<br />\n<span class= \"strong\"> Vanessa</span>: You sure it was him?<br />\n<span class= \"strong\"> Joan</span>: Yeah. He was wearing that crazy T-shirt he loves so much.<br />\n<span class= \"strong\"> Sally</span>: Oh oh. Vanessa! Vanessa, wait!<br />", "time": "77000", "id": 3}]}}], "_data": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0}], "type": "sena"}