 0, "text": "", "correct": 0}, {"id": 4, "_data": [{"content": "She is the best", "type": "text"}], "selected": 0, "text": "", "correct": 0}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "\u201cSmooth sailing\u201d means that:", "type": "text"}]}, {"content": "secondary_1", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "Sailing is good", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "Sailing is an option", "type": "text"}], "selected": 0, "correct": 0}, {"id": 2, "_data": [{"content": "Things are calm", "type": "text"}], "selected": 0, "text": "", "correct": 1}, {"id": 3, "_data": [{"content": "People are in silence", "type": "text"}], "selected": 0, "text": "", "correct": 0}, {"id": 4, "_data": [{"content": "Things are busy and noisy", "type": "text"}], "selected": 0, "text": "", "correct": 0}], "id": 1}], "_data": [{"type": "instructions", "contents": [{"content": " \nVanessa doesn't feel well. What did she say in the letter?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 1", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Read the sentence. Select the correct answer.\n", "type": "text"}, {"content": " You have 2 attempts to submit your answers.\n", "type": "text"}]}], "type": "DMC", "template_override": 1}, {"id": 3, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn9le18ob08re4aud01", "type": "audio"}, {"content": "People say that Vanessa and Peter", "type": "text"}]}, {"type": "post_question", "contents": {"content": "buddies.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "are more siblings than", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "engenn9le18ob08re4aud02", "type": "audio"}, {"content": "A friend of Vanessa told her that she", "type": "text"}]}, {"type": "post_question", "contents": {"content": "Peter having drinks.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "had seen", "type": "text"}], "selected": 0, "correct": 1}], "id": 1}, {"_data": [{"type": "question", "contents": [{"content": "engenn9le18ob08re4aud03", "type": "audio"}, {"content": "Sally said that Peter had", "type": "text"}]}, {"type": "post_question", "contents": {"content": "to throw axes.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "declined the invitation", "type": "text"}], "selected": 0, "correct": 1}], "id": 2}, {"_data": [{"type": "question", "contents": [{"content": "engenn9le18ob08re4aud04", "type": "audio"}, {"content": "Sally", "type": "text"}]}, {"type": "post_question", "contents": {"content": "that Peter had thought axe throwing was a silly idea.", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "intimated", "type": "text"}], "selected": 0, "correct": 1}], "id": 3}, {"_data": [{"type": "question", "contents": [{"content": "engenn9le18ob08re4aud05", "type": "audio"}, {"content": "We've always been able to be honest with each other, ", "type": "text"}]}, {"type": "post_question", "contents": {"content": "?", "type": ""}}, {"content": "secondary_2", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "haven't we", "type": "text"}], "selected": 0, "correct": 1}], "id": 4}], "_data": [{"type": "instructions", "contents": [{"content": " \nCan you complete these sentences?\n", "type": "text"}]}, {"type": "group", "contents": [{"content": "Activity 2", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Listen to the audio. Type in the missing words.", "type": "text"}, {"content": " You have 2 attempts to submit your answers.\n", "type": "text"}]}], "type": "TYP", "template_override": 1}, {"id": 4, "stimuli_ids": [2], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "id": 0}, {"_data": [{"type": "question", "contents": [{"content": "Subject Line:", "type": "text"}]}, {"content": "secondary_3", "type": "objective"}], "responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "