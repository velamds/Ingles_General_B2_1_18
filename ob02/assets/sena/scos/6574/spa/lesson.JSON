orrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}]}, {"stimuli_ids": [], "type": "DWS", "questions": [{"responses": [{"correct": 1, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn9le18ob02re7pdf01.pdf"}]}]}], "template_override": 1, "id": 11, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Do you have any plans with your friends?"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}]}], "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "stimuli": [{"type": "welcome", "template_override": 1, "_data": [], "id": 0, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le18ob02re2img01.jpg", "audiosrc": "engenn9le18ob02re2aud01", "images": [{"time": "0", "image": "engenn9le18ob02re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le18ob02re2img01.jpg", "text": "<span class=\"strong\">Vanessa</span>  : Well, speaking of friends, this friend has got you guys two tickets to a charity event this weekend.<br />\n<span class=\"strong\">Peter</span>  : Oooooo. Exciting! I'm in.<br />\n<span class=\"strong\">Sally</span>  : V. You're so generous. So where are we going ? <br />\n<span class=\"strong\">Vanessa</span>  : We are going to go ... axe throwing.<br />\n<span class=\"strong\">Peter</span>  : Huh? I'm out.<br />\n<span class=\"strong\">Sally</span>  : Um. What is it?<br />\n<span class=\"strong\">Vanessa</span> : It is like throwing darts, but instead of darts you throw axes. Doesn't it sound amazing?<br />\n<span class=\"strong\">Peter</span>: Nope. Still out.<br />", "id": 1}, {"time": "33000", "image": "engenn9le18ob02re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>: Peter! Listen! You get into teams; five people a team and you play and keep score. It will be extraordinary and it is for a good cause.<br />\n<span class=\"strong\">Sally</span>: When is it?<br />\n<span class=\"strong\">Vanessa</span>: This Sunday. It starts at 1:00 p.m.<br />\n<span class=\"strong\">Sally</span>: I can go. I will have finished all my work on Saturday and I figure I'll have done all my chores by 10:00 a.m. on Sunday.<br />\n<span class=\"strong\">Vanessa</span>: Good. The tickets will have arrived by Friday.<br />\n<span class=\"strong\">Peter</span>: And when will our team axes and axe throwing shirts be here?<br />", "id": 2}, {"time": "60500", "image": "engenn9le18ob02re2img02.jpg", "text": "<span class=\"strong\">Vanessa</span>: You are right. He is a jerk. C'mon Peter. What else are you going to be doing on Sunday?<br />\n<span class=\"strong\">Peter</span>: Well, let's see. On Sunday at 1:00 p.m., I will be lying on my sofa and I will be planning to either take a nap or eat a snack. Right now. It's a toss up.<br />\n<span class=\"strong\">Vanessa</span>: Oh. Didn't I mention that the tickets are on the house?<br />\n<span class=\"strong\">Peter</span>: Ooooo. I'm in again.<br/>\n<span class=\"strong\">Vanessa</span>: You are truly baffling.<br />", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Like a House on Fire"}, {"type": "unit_name", "content": "Friends Will Be Friends"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 18}, {"type": "level", "content": "B2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe situations in spoken interactions according to work and social contexts."}, {"type": "secondary_1", "content": " Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_2", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_3", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear. Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_4", "content": "Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_5", "content": " Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_6", "content": " Understands specific information in written texts about the different social and work contexts."}, {"type": "secondary_7", "content": "Understands general and detailed information as well as attitude and intention on a wide range of general and work topics, in conversations or presentations, spoken at a natural speed and in circumstances that make it more difficult to hear."}, {"type": "secondary_8", "content": " Understands specific information in written texts about the different social and work contexts."}]}, {"type": "background_image", "content": "engenn9le18ob02re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "extraordinary"}, {"type": "definition", "content": "extremely good or impressive"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Axe throwing is extraordinary."}, {"type": "audio", "content": "engenn9le18ob02aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use when talking about plans."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "chores"}, {"type": "definition", "content": "a routine or minor duty or task"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I figure I'll have done all my chores by 10:00 a.m. on Sunday."}, {"type": "audio", "content": "engenn9le18ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "axe"}, {"type": "definition", "content": "a hand tool with one side of its head forged and sharpened to a cutting edge"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We are going to go axe throwing."}, {"type": "audio", "content": "engenn9le18ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "toss up"}, {"type": "definition", "content": "a situation in which there is no clear right choice or in which what will happen is not known"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Right now, it's a toss up."}, {"type": "audio", "content": "engenn9le18ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "on the house"}, {"type": "definition", "content": "given away free by a merchant"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Didn't I mention that the tickets are on the house?"}, {"type": "audio", "content": "engenn9le18ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "baffling"}, {"type": "definition", "content": "making great mental demands; hard to comprehend or solve or believe"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You are truly baffling."}, {"type": "audio", "content": "engenn9le18ob02aud06"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " The Future"}, {"type": "describer", "content": " You can use four different tenses to talk about the future."}, {"type": "text", "content": "When you talk about things that are not decided or when you make a decision or an observation at the moment of speaking for the future, you use the modal <span class=\"italic\">will</span>."}, {"type": "text", "content": "When you ask about intentions, you use <span class=\"italic\">be going to.</span>"}, {"type": "text", "content": "When you talk about things that are arranged, on the agenda or booked for the future, you use the Present Continuous tense."}, {"type": "text", "content": "When you talk about schedules, you use the Simple Present. "}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"strong\\\">Will</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> It will be extraordinary and it is for a good cause.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Going to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"italic\\\">We are going to go axe throwing. What else are you going to be doing on Sunday?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Present Continuous</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> So where are we going?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <span class=\\\"strong\\\">Simple Present</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">It starts at 1:00 p.m.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "example", "content": "So where are we going? "}, {"type": "example", "content": "It starts at 1:00 p.m."}, {"type": "example", "content": "And when will our team axes and axe throwing shirts be here?"}, {"type": "example", "content": "What else are you going to be doing on Sunday?"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " The Future Continuous and Future Perfect Tenses"}, {"type": "describer", "content": " "}, {"type": "text", "content": " You use the <span class=\"underline\">Future Continuous</span> tense to talk about something happening at a particular time in the future.<br/> When you use the <span class=\"underline\">Future Continuous</span>, the action will have started before that moment but it will not have finished at that moment. "}, {"type": "text", "content": "For example:"}, {"type": "text", "content": "<span class=\"italic\">I will be working at 4 p.m. tomorrow. </span>"}, {"type": "text", "content": "The person will start work at some point in the future and be working at 4 p.m. It is not clear when the person will stop working. "}, {"type": "text", "content": "You use the <span class=\"underline\">Future Perfect</span> tense to talk about an action in the future before another action in the future.  <br>When you use the <span class=\"underline\">Future Perfect</span>, you can sometimes think of the Future Perfect tense like the Present Perfect tense, but instead of your viewpoint being in the present, it is in the future."}, {"type": "text", "content": "For example:"}, {"type": "text", "content": "<span class=\"italic\">You can call me at work at 8 a.m. <span class=\"strong\">I will have arrived</span> at the office by 8.</span>"}, {"type": "text", "content": "<span class=\"italic\">The train will leave the station at 9 a.m. You will arrive at the station at 9:15 a.m. When you arrive, the train <span class=\"strong\">will have left</span>.</span>"}, {"type": "text", "content": "Look at the chart for the structure of the Future Continuous and Future Perfect tenses:"}, {"type": "table", "content": "{\"rows\":3,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Name\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Structure\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Future Continuous\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" will (not) + be + v-ing\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">On Sunday at 1:00 p.m., I <span class=\\\"strong\\\">will be lying</span> on my sofa.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Future Perfect\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" will + have + past participle\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">I'<span class=\\\"strong\\\">ll have done</span> all my chores by 10:00 a.m. on Sunday.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "On Sunday at 1:00 p.m., I will be lying on my sofa and I will be planning to either take a nap or eat a snack. "}, {"type": "example", "content": "I will have finished all my work on Saturday."}, {"type": "example", "content": "I'll have done all my chores by 10:00 a.m. on Sunday."}, {"type": "example", "content": "The tickets will have arrived by Friday."}, {"type": "example", "content": "When will our team axes and axe throwing shirts be here?"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write about some future plans you have made with friends?.It can be real or imaginary."}, {"type": "text", "content": "Answer questions like: What are you doing? When will you go? Who will you be going with? What kind of activities will you be doing? What is the timetable?"}, {"type": "text", "content": "Use your answers to write up your plans using the Future Tenses."}, {"type": "text", "content": "Your description of your plan should be 100 words."}, {"type": "text", "content": "Read your description aloud to a partner and compare stories."}, {"type": "text", "content": "Who has the more interesting plan?"}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk in details about future plans with friends."}, {"type": "text", "content": "I write the full information about my plans in 100 words."}, {"type": "text", "content": "I use future tenses to talk about plans."}, {"type": "text", "content": "I share my written piece with a partner."}]}]}