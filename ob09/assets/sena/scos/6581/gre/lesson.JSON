dback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Listening"}, {"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "\nInstructions: Complete the following steps. Fill in the Self Assessment.\n"}]}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn9le18ob09re2img01.jpg", "audiosrc": "engenn9le18ob09re2aud01", "images": [{"time": "0", "image": "engenn9le18ob09re2img01.jpg", "text": "", "id": 0}, {"time": "100", "image": "engenn9le18ob09re2img01.jpg", "text": "<span class= \"strong\"> Peter</span>: Vanessa, do you have a minute?<br>\n<span class= \"strong\"> Vanessa</span> : Sorry sir. You have been served, haven't you?<br />\n<span class= \"strong\"> Peter</span>: Can we talk about your email?<br />\n<span class= \"strong\"> Vanessa</span>: Excuse me sir,  he asked me  if we could talk?<br />\n<span class= \"strong\"> Man</span>: Yes. <br />\n<span class= \"strong\"> Peter</span>: It is important, isn't it? I mean what you wrote about our friendship was pretty serious stuff. <br />\n<span class= \"strong\"> Vanessa</span>: He just asked me if it was important, right?<br />\n<span class= \"strong\"> Man</span>: Yes.<br />\n<span class= \"strong\"> Vanessa</span>: That's right Peter serious, you know, the opposite of you.<br />", "id": 1}, {"time": "29000", "image": "engenn9le18ob09re2img02.jpg", "text": "<span class= \"strong\">Vanessa</span>: You are finished with that, aren't you?<br />\n<span class= \"strong\">Peter</span>: Vanessa. Why don't we \u2026 <br />\n<span class= \"strong\">Vanessa</span>: Why don't you hush and listen to me.<br />\n<span class= \"strong\">Vanessa</span>: You didn't go to work on Sunday afternoon, did you Peter? You went downtown to another Bistro, didn't you?<br />\n<span class= \"strong\">Peter</span>: Vanessa. This is silly. Of course, you know that already. Your friend told you I was there. Oh, and by the way, what else did she say, exactly?<br />\n<span class= \"strong\">Vanessa</span>: I told you in the email what she said. She said, you were having a drink. She also said, you were watching the game instead of hanging out with your two best friends. Best friends who always listen to your troubles, who always support you and your little pitiful problems with romance. We are the friends who help you whenever you need it and we always have your back.<br />", "id": 2}, {"time": "75300", "image": "engenn9le18ob09re2img05.jpg", "text": "<span class= \"strong\">Peter</span>: Vanessa. You are making a scene.<br />\n<span class= \"strong\">Vanessa</span>: I don't care. This is my place. You know what ... you obviously still don't understand why I'm upset, so why don't you get out of my bistro.<br />\n<span class= \"strong\">Peter</span>: Really? Vanessa. I \u2026 <br />\n<span class= \"strong\">Vanessa</span>: Scram! Peter. Hit the bricks! <br />\n<span class= \"strong\">Peter</span>: C'mon V. This is ridiculous.<br />\n<span class= \"strong\">Vanessa</span>: Get your ugly face out of my place. No, not you sir. You would like another, wouldn't you?<br />", "id": 3}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}]}